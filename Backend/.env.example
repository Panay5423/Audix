# ==============================================================================
# AUDIX PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/audix
# Fallback supported:
MONGO_URL=mongodb://localhost:27017/audix

# JWT Secret for Audix session tokens
JWT_SECRET=audix_ultra_secure_jwt_secret_key_2026_change_in_production

# Spotify Developer Application Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/auth/spotify/callback
SPOTIFY_AUTHORIZATION_URL=https://accounts.spotify.com/authorize

# AI / LLM Configuration (Google Gemini API recommended)
# Get a free Gemini API key at https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
